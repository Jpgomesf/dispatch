# Copy to ~/.config/claude-harness/secrets.env (or the path in $HARNESS_SECRETS)
# and replace every placeholder. KEY=value lines; `#` starts a comment.
#
# The file must be readable by you only, or the runner refuses it:
#   chmod 600 ~/.config/claude-harness/secrets.env
#
# Re-read on every poll: add or rotate keys while the runner runs. A real
# environment variable of the same name wins over this file. The variable names
# are the ones your config.toml points to (api_key_env, email_env, token_env).

# Linear personal API key (Settings > Account > Security & access > Personal API keys)
LINEAR_API_KEY=lin_api_example0000000000000000000000000000

# Jira Cloud: your Atlassian account email and an API token
JIRA_EMAIL=sam@example.com
JIRA_API_TOKEN=example-jira-token-0000000000000000
